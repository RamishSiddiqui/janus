{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Janus",
  "version": "0.1.8",
  "identifier": "com.janus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Janus",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; img-src 'self' blob: data:; media-src 'self' blob: data:; connect-src 'self' https://* http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "avatars/*": "avatars/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwMENCQTQ0RkM3NEIyNzQKUldSMHNuVDhSTG9NOEFVVjRST0V4VHQ3a0FrcElkMTIycTdYQlNmb3ZYN29EQ0Zobm80MkpNWHcK",
      "endpoints": [
        "https://github.com/RamishSiddiqui/janus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
